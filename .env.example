# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///wifi_guard.sqlite
REPORT_DIR=instance/reports
UPLOAD_DIR=instance/uploads
DEMO_MODE=true
ENABLE_LIVE_SCAN=false
# HTTPS deployments only; leave false for localhost HTTP.
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
